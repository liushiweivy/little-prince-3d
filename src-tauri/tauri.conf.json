{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "little-prince",
  "version": "1.0.0",
  "identifier": "com.b612.littleprince",
  "build": {
    "frontendDist": "../dist-app",
    "beforeBuildCommand": "npm run app:dist",
    "devUrl": "http://127.0.0.1:8850"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小王子：星辰之旅",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
